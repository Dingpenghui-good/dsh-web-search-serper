{
  "name": "@dsh-web-search-serper",
  "version": "0.1.0",
  "description": "Serper.dev-backed web search provider for DSH (DeepSeek Harness) web capability seam",
  "keywords": [
    "deepseek",
    "harness",
    "web-search",
    "serper",
    "google-search",
    "cordis-plugin"
  ],
  "homepage": "https://github.com/dingpenghui-good/dsh-web-search-serper",
  "bugs": {
    "url": "https://github.com/dingpenghui-good/dsh-web-search-serper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingpenghui-good/dsh-web-search-serper.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "build:types": "tsc -p tsconfig.json",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsdown": "^0.22.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
